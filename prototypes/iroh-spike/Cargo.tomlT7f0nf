# wayfinder #124 原型 spike:独立 crate,不进 rdog 主 workspace。
# [workspace] 空表 = 让 cargo 把本目录当成独立 workspace 根,避免被上层 workspace 接管。
[workspace]

[package]
name = "iroh-spike"
version = "0.1.0"
edition = "2021"
publish = false

[dependencies]
anyhow = "1.0.104"
base64 = "0.23.1"
bytes = "1.12.1"
tracing = "0.1.44"
tracing-subscriber = "0.3.23"
